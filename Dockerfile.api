FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
RUN apk add --no-cache libc6-compat

# Build stage
FROM base AS builder
WORKDIR /app

# Copy package manifests first for layer caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/lyrics/package.json ./packages/lyrics/
COPY packages/music-resolver/package.json ./packages/music-resolver/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/eslint-config/package.json ./packages/eslint-config/

# Install dependencies using persistent BuildKit cache (ignore scripts until source is copied)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --ignore-scripts

# Copy application source code
COPY . .

# Run postinstall scripts now that source files are present
RUN pnpm --filter web run postinstall

# Build API and dependencies
RUN pnpm turbo run build --filter=api...

# Production runtime stage
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
RUN apk add --no-cache libc6-compat

COPY --from=builder /app /app

EXPOSE 4000

# Runs drizzle migration push to guarantee schemas exist, then starts the NestJS API
CMD ["sh", "-c", "pnpm --filter @repo/database db:push && pnpm --filter api start:prod"]
