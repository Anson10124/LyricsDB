# ==============================================================================
# LyricsDB Environment Configuration
# ==============================================================================
# ALL variables below are OPTIONAL with smart auto-detection defaults.
# You can run LyricsDB locally without editing this file, or configure external
# managed services (Supabase, Cloudflare R2, AWS S3) for free-tier self-hosting.
# ==============================================================================

# ==============================================================================
# 1. Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
# Option A: Local Docker PostgreSQL (Default - Zero configuration needed)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/lyricsdb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lyricsdb
# POSTGRES_PORT=5432

# Option B: Supabase Managed PostgreSQL (500MB Free Tier)
# 1. Main connection string (Supavisor Transaction Pooler on port 6543 for runtime API):
# DATABASE_URL=postgres://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# 2. Direct connection string (Direct Port 5432 for Drizzle migrations & schema sync):
# DIRECT_URL=postgres://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 3. SSL Configuration (Auto-enabled for Supabase domains, or enforce manually):
# DATABASE_SSL=require
# DATABASE_PREPARE=false

# ==============================================================================
# 2. Object Storage Configuration (Optional - S3 / Supabase Storage / Cloudflare R2)
# ==============================================================================
# Offload large lyrics JSON payloads to object storage so your PostgreSQL DB stays
# under the 500MB limit (scales to 1,000,000+ tracks!).
# If left unset, LyricsDB automatically stores lyrics directly in PostgreSQL.

# Option A: Supabase Storage (1GB Free Tier)
# STORAGE_BUCKET=lyrics
# STORAGE_ENDPOINT=https://[PROJECT_REF].supabase.co/storage/v1/s3
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=[SUPABASE_S3_ACCESS_KEY_ID]
# STORAGE_SECRET_ACCESS_KEY=[SUPABASE_S3_SECRET_ACCESS_KEY]
# STORAGE_FORCE_PATH_STYLE=true

# Option B: Cloudflare R2 (10GB Free Tier + 0 Egress Fees)
# STORAGE_BUCKET=lyrics
# STORAGE_ENDPOINT=https://[CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=[R2_ACCESS_KEY_ID]
# STORAGE_SECRET_ACCESS_KEY=[R2_SECRET_ACCESS_KEY]

# Option C: AWS S3 / MinIO (Self-hosted)
# STORAGE_BUCKET=lyrics
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin
# STORAGE_FORCE_PATH_STYLE=true

# ==============================================================================
# 3. API Service Configuration
# ==============================================================================
# Port for NestJS backend (Default: 4000)
# PORT=4000
# Optional public domain override for Swagger / OpenAPI documentation (Auto-detected if empty)
# PUBLIC_URL=https://lyricsdb.yourdomain.com

# ==============================================================================
# 4. Web Frontend Configuration
# ==============================================================================
# Internal URL for Next.js to proxy /api/* requests to NestJS backend (Default: http://api:4000 in Docker, http://localhost:4000 in local dev)
# API_INTERNAL_URL=http://api:4000
# Optional public API domain for standalone / cross-origin deployments (Leave empty for automatic same-domain relative routing)
# NEXT_PUBLIC_API_URL=

# ==============================================================================
# 5. Docker Compose Overrides
# ==============================================================================
# WEB_PORT=3000
# API_PORT=4000
# WEB_IMAGE=ghcr.io/anson10124/lyricsdb-web:latest
# API_IMAGE=ghcr.io/anson10124/lyricsdb-api:latest

